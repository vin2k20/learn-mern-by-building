# Copy to server/.env (git-ignored). Loaded with `node --env-file=.env` (Node 24, no dotenv needed).
# Validated at startup by src/config/env.js. The app refuses to start if something is missing.

NODE_ENV=development
PORT=4000

# A local MongoDB (install options: server/SETUP.md) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/kanvas

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# The Vite dev server origin (only needed when you call the API without the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
