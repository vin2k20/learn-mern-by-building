    "test:watch": "mocha --watch \"[0-9][0-9]-*/*.test.js\"",
    "test:01": "mocha \"01-*/*.test.js\"",
    "test:02": "mocha \"02-*/*.test.js\"",
    "test:03": "mocha \"03-*/*.test.js\"",
    "test:04": "mocha \"04-*/*.test.js\"",
    "test:05": "mocha \"05-*/*.test.js\"",
    "test:06": "mocha \"06-*/*.test.js\"",
    "test:07": "mocha \"07-*/*.test.js\"",
    "test:08": "mocha \"08-*/*.test.js\"",
    "test:09": "mocha \"09-*/*.test.js\"",
    "test:10": "mocha \"10-*/*.test.js\"",
    "test:11": "mocha \"11-*/*.test.js\"",
    "test:12": "mocha \"12-*/*.test.js\"",
    "test:13": "mocha \"13-*/*.test.js\"",
    "serve:09": "serve 09-dom-events/playground",
    "serve:10": "serve 10-canvas/playground"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "chai": "^6.2.2",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.0",
    "mocha": "^12.0.1",
    "serve": "^14.2.6",
    "sinon": "^22.1.0"
  }
