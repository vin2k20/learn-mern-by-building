# Copy this file to .env.local (git-ignored) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to client code via import.meta.env.
# ⚠️ Everything here ends up in the browser bundle. Never put secrets in client env vars.

# true  → the MSW mock API (Days 3–6)
# false → the real Express server via the Vite proxy (Day 7)
VITE_USE_MOCKS=true

# Base path for REST calls (the Vite dev server proxies it to http://localhost:4000)
VITE_API_URL=/api
